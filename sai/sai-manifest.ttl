prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>
prefix xsd: <http://www.w3.org/2001/XMLSchema#>
prefix dcterms: <http://purl.org/dc/terms/>
prefix td: <http://www.w3.org/2006/03/test-description#>
prefix spec: <http://www.w3.org/ns/spec#>

# Latest published version
prefix sopr: <https://solidproject.org/TR/protocol#>

prefix manifest: <#>

manifest:authentication-header
  a td:TestCase ;
  spec:requirementReference
    sopr:server-authentication,
    sopr:server-unauthenticated ;
  td:reviewStatus td:approved ;
  spec:testScript
    <https://github.com/solid-contrib/specification-tests/blob/main/sai/discovery.feature> .

